# Gemini APIキー（Google AI Studioで発行）。複数キーをカンマ区切りでGEMINI_API_KEYSに
# 設定すると、クォータ超過/失敗時に順番に次のキーへフォールバックする(collect.py参照)。
# GEMINI_API_KEYSが無ければGEMINI_API_KEY(単一)にフォールバックする。
GEMINI_API_KEY=
GEMINI_API_KEYS=

# 使用するGeminiモデル（無料枠のFlash-Lite系を推奨）
GEMINI_MODEL=gemini-2.5-flash-lite

# 低confidence判定時の再判定に使う上位モデル（未設定時はgemini-2.5-proを使用）
GEMINI_ESCALATION_MODEL=

# セッションCookieの署名鍵。空なら初回起動時にwebapp.pyが自動生成して書き込む
# (手動で設定する必要はない。再起動のたびに変わると全ユーザーがログアウトされてしまうため
# .envに永続化している)。
SECRET_KEY=

# HTTPS配信にした場合のみ1を設定する(SESSION_COOKIE_SECUREを有効にする)。
# Tailscale IP直打ちのHTTP配信のままなら未設定(空)でよい。
FORCE_HTTPS_COOKIES=

# ディスク逼迫・頻繁な再起動・大量の画像取得失敗などをプッシュ通知したい場合に設定する
# (Slack等のIncoming Webhook URL)。未設定なら通知は送らず、従来通り管理画面でのみ確認する。
ALERT_WEBHOOK_URL=
