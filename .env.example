# Gemini APIキー（Google AI Studioで発行）。複数キーをカンマ区切りでGEMINI_API_KEYSに
# 設定すると、クォータ超過/失敗時に順番に次のキーへフォールバックする(collect.py参照)。
# GEMINI_API_KEYSが無ければGEMINI_API_KEY(単一)にフォールバックする。
GEMINI_API_KEY=
GEMINI_API_KEYS=

# 使用するGeminiモデル（無料枠のFlash-Lite系を推奨）。
# 2026-08-29にgemini-2.5-flash-lite/gemini-2.5-proがGoogle側で廃止され、
# 既存モデル名のままだと404 NOT_FOUNDで失敗するようになった(1回発生済み)。
# モデル名が使えなくなった場合はエラーメッセージにGoogleが案内する後継モデル名が
# 出るので、それに置き換えること。
GEMINI_MODEL=gemini-3.5-flash-lite

# 低confidence判定時の再判定に使う上位モデル（未設定時はgemini-3.1-pro-previewを使用）
GEMINI_ESCALATION_MODEL=

# セッションCookieの署名鍵。空なら初回起動時にwebapp.pyが自動生成して書き込む
# (手動で設定する必要はない。再起動のたびに変わると全ユーザーがログアウトされてしまうため
# .envに永続化している)。
SECRET_KEY=

# HTTPS配信にした場合のみ1を設定する(SESSION_COOKIE_SECUREを有効にする)。
# Tailscale IP直打ちのHTTP配信のままなら未設定(空)でよい。
FORCE_HTTPS_COOKIES=

# ディスク逼迫・頻繁な再起動・大量の画像取得失敗などをプッシュ通知したい場合に設定する
# (Slack等のIncoming Webhook URL)。未設定なら通知は送らず、従来通り管理画面でのみ確認する。
ALERT_WEBHOOK_URL=

# AIチャット機能の1日あたりの質問回数上限(無料枠のクォータを画像分類等と共有しているため)。
# 利用者1人あたりの上限とサイト全体の上限の両方を満たす必要がある(小さい方が適用される)。
# 実際の利用量は管理画面の「Gemini状況」ページで確認できる。
AI_CHAT_DAILY_LIMIT_PER_USER=10
AI_CHAT_DAILY_LIMIT_TOTAL=50

# nginx側だけがX-Rf-Internalヘッダーに付与する合言葉(Tailscale Funnel経由の
# 公開アクセスと内部アクセスを区別するために使う)。未設定なら初回起動時にwebapp.py
# が自動生成して.envに書き込む(手動で設定する必要はない)。生成後の値は
# /etc/nginx/sites-available/river-fog のX-Rf-Internalヘッダー設定にも
# 手動でコピーすること(nginx設定はGit管理外)。
NGINX_INTERNAL_HEADER_SECRET=
